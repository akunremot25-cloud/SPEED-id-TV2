rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'number', 'name', 'category', 'streamUrl']) &&
        data.id is string && data.id.size() <= 128 &&
        data.number is number &&
        data.name is string && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 50 &&
        data.streamUrl is string && data.streamUrl.size() <= 1000;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'status', 'createdAt', 'expiresAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.name is string && data.name.size() <= 100 &&
        (data.status == 'active' || data.status == 'disabled' || data.status == 'expired') &&
        data.createdAt is string &&
        data.expiresAt is string;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['id', 'adminPin', 'updatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.adminPin is string && data.adminPin.size() <= 64 &&
        data.updatedAt is string;
    }

    // Channels collection
    match /channels/{channelId} {
      // Anyone can read channels (live viewing for all clients)
      allow read: if true;

      // Allow creating channels with valid schema
      allow create: if isValidId(channelId) && isValidChannel(incoming());

      // Allow updating channels
      allow update: if isValidId(channelId) && isValidChannel(incoming());

      // Allow deleting channels
      allow delete: if isValidId(channelId);
    }

    // Subscribers & activation codes collection
    match /subscribers/{subscriberId} {
      // Allow read to verify codes and sync status
      allow read: if true;

      // Allow create with valid schema
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());

      // Allow update with valid schema (status toggles, expiration updates)
      allow update: if isValidId(subscriberId) && isValidSubscriber(incoming());

      // Allow deleting subscriber
      allow delete: if isValidId(subscriberId);
    }

    // System settings & Administrator PIN collection
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isValidSetting(incoming());
      allow update: if isValidId(settingId) && isValidSetting(incoming());
      allow delete: if isValidId(settingId);
    }
  }
}
