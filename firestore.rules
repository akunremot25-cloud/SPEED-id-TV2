rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'number', 'name', 'category', 'streamUrl']) &&
        data.id is string && data.id.size() <= 128 &&
        data.number is number &&
        data.name is string && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 50 &&
        data.streamUrl is string && data.streamUrl.size() <= 1000;
    }

    // Channels collection
    match /channels/{channelId} {
      // Anyone can read channels (live viewing for all clients)
      allow read: if true;

      // Allow creating channels with valid schema
      allow create: if isValidId(channelId) && isValidChannel(incoming());

      // Allow updating channels
      allow update: if isValidId(channelId) && isValidChannel(incoming());

      // Allow deleting channels
      allow delete: if isValidId(channelId);
    }
  }
}
